{
  "name": "@gamenite/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "tsc",
    "lint": "eslint .",
    "prettier": "prettier --ignore-path ../.gitignore --check . ",
    "prettier:fix": "prettier --ignore-path ../.gitignore --write .",
    "test": "vitest run --coverage",
    "dev": "node --watch ./src/server.ts",
    "start": "MODE=production node ./src/server.ts",
    "migrate": "node ./src/migrate.ts up",
    "migrate:status": "node ./src/migrate.ts status",
    "migrate:create": "node ./src/migrate.ts create"
  },
  "dependencies": {
    "@gamenite/shared": "^1.0.0",
    "@keyv/mongo": "^3.1.0",
    "express": "^5.2.1",
    "dotenv": "^17.2.3",
    "keyv": "^5.6.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
