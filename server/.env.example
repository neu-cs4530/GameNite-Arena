# GameNite Arena server environment.
#
# Copy this file to `server/.env` and adjust if needed.
# The defaults below match the services in the repo-root docker-compose.yml,
# so the typical dev workflow is:
#
#   docker compose up -d
#   cp server/.env.example server/.env
#   npm run -w server migrate
#   npm run dev

# MongoDB connection for the keyv data store.
# Matches the `mongo` service in docker-compose.yml.
MONGO_STR=mongodb://localhost:27017
MONGO_DB_NAME=GameNite

# Redis connection for the BullMQ training queue and the WebSocket bridge.
# Matches the `redis` service in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Optional: server port (defaults to 8000).
# PORT=8000

# Optional: production mode. Leave unset for local dev; setting MODE=production
# makes Express serve the prebuilt client bundle from client/dist.
# MODE=production
